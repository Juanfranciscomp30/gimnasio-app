# Copia este archivo a .env y rellena los valores. NUNCA subas el .env a git.

# Base de datos (Supabase): pooler (6543) para la app, directa (5432) para migraciones
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Asistente IA (Claude). Solo se usa en el servidor: no le pongas el prefijo NEXT_PUBLIC_.
# Sin esta variable la app funciona igual y oculta las funciones de IA.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5"
# AI_ADMIN_DAILY_LIMIT=20

# Supabase (subida de foto de perfil)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email (Resend) — solo si activas la confirmación por email
# EMAIL_VERIFICATION_ENABLED=true
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Demo pública: botones de acceso con un clic en /login
# NEXT_PUBLIC_DEMO_MODE=true

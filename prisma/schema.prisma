// Esquema de base de datos - Gimnasio App
// Ejecutar: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

// Tarifa contratada: cuántos días por semana puede reservar el usuario
enum WeeklyPlan {
  ONE_DAY    // 1 día/semana
  TWO_DAYS   // 2 días/semana
  THREE_DAYS // 3 días/semana
}

enum BookingStatus {
  CONFIRMED
  CANCELLED_ON_TIME   // Cancelada con >= 3h de antelación -> libera hueco y NO consume el día
  CANCELLED_LATE      // Cancelada con < 3h de antelación -> libera hueco pero SÍ consume el día (lo pierde)
  WAITLISTED          // Clase completa: en lista de espera, no consume el día hasta confirmarse
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         Role       @default(USER)
  weeklyPlan   WeeklyPlan @default(ONE_DAY)
  createdByAdmin Boolean  @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Confirmación de email al registrarse (evita altas masivas de bots).
  // null = cuenta pendiente de confirmar. Los usuarios que da de alta el
  // admin a mano se marcan verificados en el momento, no pasan por esto.
  emailVerified            DateTime?
  verificationToken        String?   @unique
  verificationTokenExpires DateTime?

  profileImageUrl          String?
  cancellationRequested    Boolean   @default(false)
  cancellationRequestedAt  DateTime?

  bookings      Booking[]
  payments      Payment[]
  notifications Notification[]
  fitnessProfile FitnessProfile?
  aiPlans        AiPlan[]
  setLogs        SetLog[]
}

// Una clase concreta en un día y hora, con aforo limitado
model ClassSession {
  id        String    @id @default(cuid())
  date      DateTime  // fecha y hora de inicio de la clase
  capacity  Int       // aforo máximo
  cancelled Boolean   @default(false) // clase cancelada por el gimnasio (no se borra, se conserva el historial)
  createdAt DateTime  @default(now())

  bookings  Booking[]

  @@index([date])
}

// Reserva de un usuario sobre una clase concreta
model Booking {
  id             String        @id @default(cuid())
  userId         String
  classSessionId String
  status         BookingStatus @default(CONFIRMED)
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?

  user         User         @relation(fields: [userId], references: [id])
  classSession ClassSession @relation(fields: [classSessionId], references: [id])

  @@unique([userId, classSessionId]) // un usuario no puede reservar 2 veces la misma clase
  @@index([classSessionId])
}

model Payment {
  id         String     @id @default(cuid())
  userId     String
  weeklyPlan WeeklyPlan
  amount     Float
  paidAt     DateTime   @default(now())
  validUntil DateTime   // hasta cuándo cubre este pago

  user User @relation(fields: [userId], references: [id])

  // Cada reserva/cambio/cancelación consulta "el último pago de este
  // usuario" (findFirst where userId, orderBy paidAt desc) — sin este
  // índice esa consulta, que es de las más frecuentes de toda la app,
  // recorre la tabla entera cada vez.
  @@index([userId, paidAt])
}

// Gasto del gimnasio (luz, maquinaria, etc.) — no está ligado a ningún
// usuario, es solo para que el admin lleve el control de sus costes.
model Expense {
  id        String   @id @default(cuid())
  concept   String
  amount    Float
  category  String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([date])
}

// Aviso dentro de la app para un usuario (ej: "tu clase cambió de hora").
// Sin email ni push: se muestra en /inicio hasta que el usuario la descarta.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

// ─── IA ──────────────────────────────────────────────────────────────

// Cuestionario que rellena el socio en /perfil para que la IA pueda
// personalizar entrenos y nutrición. Una fila por usuario (1 a 1).
model FitnessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  goal              String   // PERDER_GRASA | GANAR_MUSCULO | MEJORAR_FORMA | SALUD_GENERAL
  level             String   // PRINCIPIANTE | INTERMEDIO | AVANZADO
  minutesPerSession Int      @default(60)
  trainsAtHome      Boolean  @default(false) // si quiere rutinas extra para los días que no viene
  dietPreference    String?  // OMNIVORA | VEGETARIANA | VEGANA | SIN_PREFERENCIA
  limitations       String?  // texto libre opcional (ej: "molestias de rodilla")
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AiPlanKind {
  TRAINING
  NUTRITION
}

// Plan generado por la IA para un socio. Guardamos el histórico (no se
// sobrescribe) y la pantalla muestra siempre el más reciente. También
// sirve para limitar cuántas veces se genera por semana (control de coste).
model AiPlan {
  id        String     @id @default(cuid())
  userId    String
  kind      AiPlanKind
  content   Json
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

// Informe generado por la IA para el admin (resumen semanal). Se cachea
// unas horas para no llamar a la API cada vez que se abre la página.
model AiReport {
  id        String   @id @default(cuid())
  kind      String   // RESUMEN_SEMANAL | REACTIVACION
  content   Json
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// ─── TABLAS DE EJERCICIOS ────────────────────────────────────────────

// Catálogo de ejercicios que gestiona el admin (press banca, sentadilla...).
// Los pesos que apunta cada socio van ligados al EJERCICIO, no a la tabla
// del mes: así, si un ejercicio vuelve a salir dos meses después, la app
// recuerda el último peso que levantó con él.
model Exercise {
  id          String   @id @default(cuid())
  name        String   @unique
  muscleGroup String?
  notes       String?
  createdAt   DateTime @default(now())

  routineExercises RoutineExercise[]
  setLogs          SetLog[]
}

// Tabla de ejercicios de un mes para una tarifa concreta. Hay como mucho
// una por (año, mes, tarifa): el socio ve automáticamente la que le toca
// según su weeklyPlan, sin que el admin tenga que asignarla a mano.
model Routine {
  id         String     @id @default(cuid())
  year       Int
  month      Int // 1-12
  weeklyPlan WeeklyPlan
  title      String?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  days RoutineDay[]

  @@unique([year, month, weeklyPlan])
}

// Cada día de entrenamiento de la tabla (Día 1, Día 2...). Una tabla de
// la tarifa de 3 días tiene 3 RoutineDay, la de 2 días tiene 2, etc.
model RoutineDay {
  id        String  @id @default(cuid())
  routineId String
  dayNumber Int // 1, 2 o 3
  name      String? // ej: "Pierna y glúteo"

  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@unique([routineId, dayNumber])
}

// Un ejercicio dentro de un día de la tabla, con sus series/repeticiones.
model RoutineExercise {
  id           String  @id @default(cuid())
  routineDayId String
  exerciseId   String
  order        Int
  sets         Int
  reps         String // texto para permitir rangos: "10", "8-12", "30 seg"
  restSeconds  Int?
  notes        String?

  routineDay RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([routineDayId, order])
  @@index([exerciseId])
}

// Una serie que ha hecho un socio: peso y repeticiones de un ejercicio en
// un día concreto. Varias filas por (usuario, ejercicio, día) = varias series.
model SetLog {
  id          String   @id @default(cuid())
  userId      String
  exerciseId  String
  sessionDate DateTime @db.Date // día del entreno (sin hora)
  setNumber   Int
  weight      Float // kg
  reps        Int
  createdAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([userId, exerciseId, sessionDate])
}

// Esquema de base de datos - Gimnasio App
// Ejecutar: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

// Tarifa contratada: cuántos días por semana puede reservar el usuario
enum WeeklyPlan {
  ONE_DAY    // 1 día/semana
  TWO_DAYS   // 2 días/semana
  THREE_DAYS // 3 días/semana
}

enum BookingStatus {
  CONFIRMED
  CANCELLED_ON_TIME   // Cancelada con >= 3h de antelación -> libera hueco y NO consume el día
  CANCELLED_LATE      // Cancelada con < 3h de antelación -> libera hueco pero SÍ consume el día (lo pierde)
  WAITLISTED          // Clase completa: en lista de espera, no consume el día hasta confirmarse
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         Role       @default(USER)
  weeklyPlan   WeeklyPlan @default(ONE_DAY)
  createdByAdmin Boolean  @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Confirmación de email al registrarse (evita altas masivas de bots).
  // null = cuenta pendiente de confirmar. Los usuarios que da de alta el
  // admin a mano se marcan verificados en el momento, no pasan por esto.
  emailVerified            DateTime?
  verificationToken        String?   @unique
  verificationTokenExpires DateTime?

  profileImageUrl          String?
  cancellationRequested    Boolean   @default(false)
  cancellationRequestedAt  DateTime?

  bookings      Booking[]
  payments      Payment[]
  notifications Notification[]
  fitnessProfile FitnessProfile?
  aiPlans        AiPlan[]
}

// Una clase concreta en un día y hora, con aforo limitado
model ClassSession {
  id        String    @id @default(cuid())
  date      DateTime  // fecha y hora de inicio de la clase
  capacity  Int       // aforo máximo
  cancelled Boolean   @default(false) // clase cancelada por el gimnasio (no se borra, se conserva el historial)
  createdAt DateTime  @default(now())

  bookings  Booking[]

  @@index([date])
}

// Reserva de un usuario sobre una clase concreta
model Booking {
  id             String        @id @default(cuid())
  userId         String
  classSessionId String
  status         BookingStatus @default(CONFIRMED)
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?

  user         User         @relation(fields: [userId], references: [id])
  classSession ClassSession @relation(fields: [classSessionId], references: [id])

  @@unique([userId, classSessionId]) // un usuario no puede reservar 2 veces la misma clase
  @@index([classSessionId])
}

model Payment {
  id         String     @id @default(cuid())
  userId     String
  weeklyPlan WeeklyPlan
  amount     Float
  paidAt     DateTime   @default(now())
  validUntil DateTime   // hasta cuándo cubre este pago

  user User @relation(fields: [userId], references: [id])

  // Cada reserva/cambio/cancelación consulta "el último pago de este
  // usuario" (findFirst where userId, orderBy paidAt desc) — sin este
  // índice esa consulta, que es de las más frecuentes de toda la app,
  // recorre la tabla entera cada vez.
  @@index([userId, paidAt])
}

// Gasto del gimnasio (luz, maquinaria, etc.) — no está ligado a ningún
// usuario, es solo para que el admin lleve el control de sus costes.
model Expense {
  id        String   @id @default(cuid())
  concept   String
  amount    Float
  category  String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([date])
}

// Aviso dentro de la app para un usuario (ej: "tu clase cambió de hora").
// Sin email ni push: se muestra en /inicio hasta que el usuario la descarta.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

// ─── IA ──────────────────────────────────────────────────────────────

// Cuestionario que rellena el socio en /perfil para que la IA pueda
// personalizar entrenos y nutrición. Una fila por usuario (1 a 1).
model FitnessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  goal              String   // PERDER_GRASA | GANAR_MUSCULO | MEJORAR_FORMA | SALUD_GENERAL
  level             String   // PRINCIPIANTE | INTERMEDIO | AVANZADO
  minutesPerSession Int      @default(60)
  trainsAtHome      Boolean  @default(false) // si quiere rutinas extra para los días que no viene
  dietPreference    String?  // OMNIVORA | VEGETARIANA | VEGANA | SIN_PREFERENCIA
  limitations       String?  // texto libre opcional (ej: "molestias de rodilla")
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AiPlanKind {
  TRAINING
  NUTRITION
}

// Plan generado por la IA para un socio. Guardamos el histórico (no se
// sobrescribe) y la pantalla muestra siempre el más reciente. También
// sirve para limitar cuántas veces se genera por semana (control de coste).
model AiPlan {
  id        String     @id @default(cuid())
  userId    String
  kind      AiPlanKind
  content   Json
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

// Informe generado por la IA para el admin (resumen semanal). Se cachea
// unas horas para no llamar a la API cada vez que se abre la página.
model AiReport {
  id        String   @id @default(cuid())
  kind      String   // RESUMEN_SEMANAL
  content   Json
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}
